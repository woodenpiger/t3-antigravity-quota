{
  "name": "t3-antigravity-quota",
  "version": "2.1.0",
  "description": "Liquid Glass Antigravity quota monitor plugin for T3 Code (Beta) on Windows — zero dependencies, embedded server hook, hover mini preview & click detail view.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "install-plugin": "node scripts/install.mjs --close-t3",
    "uninstall-plugin": "node scripts/uninstall.mjs --close-t3",
    "health": "node scripts/health.mjs",
    "test": "node --test helper/test/quota.test.cjs",
    "preview:fixture": "node helper/fixture-server.cjs healthy 47899",
    "preview:ui": "node scripts/preview-server.mjs 47899 47898"
  },
  "keywords": [
    "t3code",
    "antigravity",
    "quota",
    "liquid-glass",
    "electron-plugin",
    "windows"
  ]
}
